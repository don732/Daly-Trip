server {
    listen 80;
    listen [::]:80;

    server_name dalytrips.com www.dalytrips.com;

    client_max_body_size 20M;

    access_log /var/log/nginx/dalytrips_access.log;
    error_log /var/log/nginx/dalytrips_error.log;

    # Replace YOUR_PROJECT with your Supabase project ref (e.g. ajzvsxnazmekevwxrphr)
    set $supabase_functions https://YOUR_PROJECT.supabase.co/functions/v1;

    location /api/starter {
        proxy_pass $supabase_functions/starter-reply;
        proxy_http_version 1.1;
        proxy_set_header Host YOUR_PROJECT.supabase.co;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/push/send {
        proxy_pass $supabase_functions/push-send;
        proxy_http_version 1.1;
        proxy_set_header Host YOUR_PROJECT.supabase.co;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/push/subscribe {
        proxy_pass $supabase_functions/push-subscribe;
        proxy_http_version 1.1;
        proxy_set_header Host YOUR_PROJECT.supabase.co;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
